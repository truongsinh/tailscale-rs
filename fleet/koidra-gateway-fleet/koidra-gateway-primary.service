[Unit]
Description=Koidra Gateway — primary channel (tailnet access service)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# ExecStart uses the run.sh wrapper so the updater's atomic current-koidra-gateway.txt
# swap is picked up on each Restart=on-failure relaunch. Override the binary via the
# 3rd arg (see rollout scripts).
Environment=AUTHKEY=${KOIDRA_PRIMARY_AUTHKEY}
Environment=KOIDRA_MANIFEST_URL=${KOIDRA_MANIFEST_URL}
Environment=KOIDRA_TARGET=x86_64-unknown-linux-musl
WorkingDirectory=/opt/koidra-gateway
ExecStart=/opt/koidra-gateway/run.sh primary 2222

# Supervisor semantics: restart on unexpected exit, but bail after 2 failures
# in 60 s so a wedged binary doesn't spin forever (the rollback path is the
# updater's manifest pointer, not an auto-revert here — see
# .doc/2026-07-supervisor-restart-interface.md §3).
Restart=on-failure
RestartSec=5
StartLimitBurst=2
StartLimitIntervalSec=60

# Hardening — keep the surface minimal. Device access is required for the
# tailnet TUN device; networking is obvious; no shell or ptrace.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/koidra-gateway

[Install]
WantedBy=multi-user.target
