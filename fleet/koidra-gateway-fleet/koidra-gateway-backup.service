[Unit]
Description=Koidra Gateway — backup channel (tailnet access service, redundant)
After=network-online.target koidra-gateway-primary.service
Wants=network-online.target

[Service]
Type=simple
# Self-contained (see koidra-gateway-primary.service for the rationale).
# TS_HOSTNAME MUST match the old koidra-ssh backup node name so identity /
# console name does not churn on the rebrand.
Environment=TS_HOSTNAME=vn-office-dev-server-backup
# Baked auth key. Replace the placeholder with the real tskey-auth-... token on
# the box (systemctl edit / EnvironmentFile drop-in) before enabling.
Environment=AUTHKEY=tskey-auth-PLACEHOLDER-bake-real-key-here
Environment=KOIDRA_TARGET=x86_64-unknown-linux-musl
WorkingDirectory=/home/sinh/koidra-gateway
ExecStart=/home/sinh/koidra-gateway/run.sh backup 2223

Restart=on-failure
RestartSec=5
StartLimitBurst=2
StartLimitIntervalSec=60

# ProtectHome intentionally NOT set (install dir under /home) — see primary unit.
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
ReadWritePaths=/home/sinh/koidra-gateway

[Install]
WantedBy=multi-user.target
